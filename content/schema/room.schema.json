{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://townsmith.local/schema/room.schema.json",
  "title": "Townsmith room content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "rooms"],
  "properties": {
    "format_version": { "const": 1 },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/room" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_./-]+$"
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "category", "min_area_m2", "required_tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name_key": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": ["living", "service", "work", "circulation", "storage", "other"]
        },
        "min_area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "required_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_./-]+$" }
        },
        "draft": { "type": "boolean" }
      }
    }
  }
}
