{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://townsmith.local/schema/prop.schema.json",
  "title": "Townsmith prop content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "props"],
  "properties": {
    "format_version": { "const": 1 },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/prop" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_./-]+$"
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "footprint_m", "height_m", "cost", "allowed_rooms", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name_key": { "type": "string", "minLength": 1 },
        "footprint_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "height_m": { "type": "number", "exclusiveMinimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "allowed_rooms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_./-]+$" }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_./-]+$" }
        },
        "draft": { "type": "boolean" }
      }
    }
  }
}
